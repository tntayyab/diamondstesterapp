# ============================================================================
#  DIAMONDS TESTER — MOBILE APP ENVIRONMENT VARIABLES (TEMPLATE)
# ----------------------------------------------------------------------------
#  1. Copy this file to ".env"          →   cp .env.example .env
#  2. Fill in the real values below.
#  3. ".env" is git-ignored — your keys are NEVER pushed to GitHub.
#
#  HOW EXPO ENV VARS WORK — read this before adding a new key:
#    • Only variables prefixed with EXPO_PUBLIC_ reach the running app.
#    • They are INLINED INTO THE JS BUNDLE at build time. Anyone who unzips
#      your .apk / .ipa can read them. Treat every EXPO_PUBLIC_ value as
#      PUBLIC INFORMATION.
#    • Therefore: NEVER put a secret (service-role key, Anthropic key,
#      Paddle API key) behind EXPO_PUBLIC_ in a production build.
#    • Secrets belong in the Supabase Edge Function — see SECTION 5.
#    • After editing this file, restart Metro with a cleared cache:
#          npx expo start --clear
# ============================================================================


# ============================================================================
#  SECTION 1 — SUPABASE  (REQUIRED)
# ----------------------------------------------------------------------------
#  Where to find these:
#    Sign in to https://supabase.com → open the project → Project Settings
#    → API Keys
#      · "Project URL"      → EXPO_PUBLIC_SUPABASE_URL
#      · "Publishable key"  → EXPO_PUBLIC_SUPABASE_ANON_KEY   (starts sb_publishable_…)
#
#  The anon/publishable key is SAFE to ship — Row Level Security protects your
#  data. The "secret"/service-role key is NOT — it must never appear in this
#  file with an EXPO_PUBLIC_ prefix.
#
#  This is the SAME Supabase project the DiamondsTester WEBSITE
#  (diamondstester.com) uses, so accounts/credits sync across web + mobile.
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# ============================================================================
#  SECTION 2 — AI IDENTIFICATION  (REQUIRED for live scans)
# ----------------------------------------------------------------------------
#  The app never calls Anthropic directly in production. It calls a Supabase
#  Edge Function which holds the Anthropic key server-side. See SECTION 5 for
#  how to deploy it.
#
#  EXPO_PUBLIC_IDENTIFY_FUNCTION
#    Name of the Edge Function. This app uses "identify-diamond" — a new,
#    separate function name from the Spider Identifier app's "identify", so
#    both apps can share the same Supabase project without colliding.
#
#  EXPO_PUBLIC_IDENTIFY_URL   (optional override)
#    Full URL of an alternative endpoint — e.g. reuse the website's route:
#      https://diamondstester.com/api/identify
#    Leave blank to use the Edge Function.
#
#  Model IDs:
#    claude-haiku-4-5    — fast, cheap, used for free-tier scans.
#    claude-sonnet-4-6   — used for pro-tier scans. NOTE: the website's
#      analyzer (diamondstester.com, see D:\diamondstester\.env.local) already
#      uses claude-sonnet-4-6, so this app matches it for consistency across
#      web + app, rather than defaulting to the newest available model.
#  Do NOT append date suffixes; these alias strings are complete as written.
# ============================================================================
EXPO_PUBLIC_IDENTIFY_FUNCTION=identify-diamond
EXPO_PUBLIC_IDENTIFY_URL=
EXPO_PUBLIC_AI_MODEL_FREE=claude-haiku-4-5
EXPO_PUBLIC_AI_MODEL_PRO=claude-sonnet-4-6


# ----------------------------------------------------------------------------
#  ⚠️  LOCAL DEVELOPMENT ONLY — INSECURE  ⚠️
#
#  EXPO_PUBLIC_ANTHROPIC_API_KEY lets the app call api.anthropic.com directly,
#  skipping the Edge Function. Handy while testing on your own phone before
#  the function is deployed. It bakes your billing key into the JS bundle.
#
#  → Get a key: https://console.anthropic.com  →  Settings  →  API Keys
#               →  "Create Key"  →  copy the  sk-ant-api03-…  value.
#               (You are not currently billed until you add credit.)
#
#  → LEAVE THIS BLANK for any build you distribute. Ever.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_ANTHROPIC_API_KEY=


# ============================================================================
#  SECTION 3 — REVENUECAT BILLING  (optional — paywall degrades gracefully)
# ----------------------------------------------------------------------------
#  RevenueCat replaces the website's checkout, because Apple and Google
#  require in-app purchases for digital goods sold inside a mobile app.
#
#  Step by step:
#    1. Create a free account at https://app.revenuecat.com
#    2. Projects → "+ New Project" → name it "Diamonds Tester"
#    3. Project Settings → Apps → "+ App Store" and "+ Play Store"
#         · iOS  bundle id : com.appsrocks24.diamondstester
#         · Android package: com.appsrocks24.diamondstester
#    4. Each app page shows a "Public SDK Key":
#         · Apple key  starts with  appl_…   → EXPO_PUBLIC_REVENUECAT_IOS_KEY
#         · Google key starts with  goog_…   → EXPO_PUBLIC_REVENUECAT_ANDROID_KEY
#       (Public SDK keys are designed to ship in the app — safe here.
#        The "Secret API key" is NOT — never put it in this file.)
#    5. Product Catalog → Entitlements → "+ New" → identifier: pro
#    6. Product Catalog → Offerings → "default" → attach your subscription
#       products and mark them for the "pro" entitlement.
#
#  RevenueCat is a native module: it does NOT run in Expo Go. Build a dev
#  client first —   npx expo run:android   or   eas build --profile development
#  With no keys set, the paywall still renders but purchases are disabled.
# ============================================================================
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro
EXPO_PUBLIC_REVENUECAT_OFFERING=default


# ============================================================================
#  SECTION 3b — GOOGLE ADMOB  (rewarded "watch ad → earn credits" ads)
# ----------------------------------------------------------------------------
#  Leave these BLANK to use Google's public TEST ad unit — the app then shows
#  real (test) rewarded ads with NO AdMob account, so you can try the flow now.
#  Test ads pay nothing; switch to your own ids before release.
#
#  To earn real money:
#    1. Sign up at  https://admob.google.com  (free). Create a NEW AdMob app
#       for Diamonds Tester — do not reuse the Spider Identifier one.
#    2. Apps → Add app → Android → package name  com.appsrocks24.diamondstester
#    3. Copy the App ID (looks like  ca-app-pub-0000000000000000~1111111111 )
#       and paste it into  app.json  under the react-native-google-mobile-ads
#       plugin  ->  "androidAppId"  (this is baked at build time, not here).
#       app.json currently has a placeholder  ca-app-pub-0000000000000000~0000000000
#       that MUST be replaced before release.
#    4. Ad units → Add ad unit → Rewarded → copy its id
#       (looks like  ca-app-pub-0000000000000000/2222222222 )  into the line
#       below, then rebuild the APK.
#
#  App ID  (~ separator) goes in app.json.  Ad-unit ID  (/ separator) goes here.
#  Rewarded = chat "watch ad for credits". Banner = bottom of browse screens.
#  Interstitial = full-screen after a scan result / quiz (frequency-capped).
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
# "1" = force Google TEST ads on every slot (always fill — confirm ads work).
# "0" (default) = serve your real ads. Set 0 before publishing to earn money.
EXPO_PUBLIC_ADMOB_TEST_MODE=0


# ============================================================================
#  SECTION 4 — APP BEHAVIOUR  (safe defaults — change only if you know why)
# ----------------------------------------------------------------------------
#  Keep these in sync with the website's auth/credits logic, or signed-in
#  users will see a different credit balance on web vs mobile.
# ============================================================================
EXPO_PUBLIC_SITE_URL=https://diamondstester.com
# TODO: confirm/change this support email before release.
EXPO_PUBLIC_SUPPORT_EMAIL=chaos.and.lovefam@gmail.com

# Credits deducted per AI identification (keep in sync with the website)
EXPO_PUBLIC_CREDITS_PER_SCAN=10

# Free scans before a guest must sign up
EXPO_PUBLIC_GUEST_FREE_SCANS=2

# "1" = when no AI backend is reachable, show a bundled demo result instead of
# an error, so the app is always demoable. "0" = surface the real error.
EXPO_PUBLIC_ENABLE_DEMO_FALLBACK=1


# ============================================================================
#  SECTION 5 — SERVER-SIDE SECRETS  (never prefixed, never bundled)
# ----------------------------------------------------------------------------
#  These are NOT read by the app. They are listed here as documentation so you
#  know what the Edge Function needs. Set them with the Supabase CLI:
#
#      npm i -g supabase
#      supabase login
#      supabase link --project-ref <your-project-ref>
#      supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
#      supabase functions deploy identify-diamond
#
#  SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into every Edge
#  Function automatically — you do not set those by hand.
#
#  ANTHROPIC_API_KEY   →  https://console.anthropic.com → Settings → API Keys
#                         This is the SAME env var name the DiamondsTester
#                         WEBSITE uses (D:\diamondstester\.env.local,
#                         currently blank there too) — obtain one key and
#                         share it between web + app.
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-api03-...
