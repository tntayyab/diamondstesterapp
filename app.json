{
  "expo": {
    "name": "Diamonds Tester",
    "slug": "diamonds-tester",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "diamondstester",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#6366F1",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diamondstester.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.diamondstester.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#070B13"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070B13"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Diamonds Tester to access your photos so you can identify a diamond or gemstone from an existing picture.",
          "cameraPermission": "Allow Diamonds Tester to access your camera to photograph your diamond or gemstone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366F1"
        }
      ],
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Diamonds Tester to use your location to tag where you found or tested a gemstone."
        }
      ],
      "./plugins/withUploadSigning"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c6e568c-d6e4-4c14-9961-f0bdbf08ac93"
      }
    },
    "owner": "ninjamul"
  }
}
